# Ominifix AI Enhanced Self-Healing RPA Framework
# Environment Configuration Template
# Copy this file to .env and customize as needed

# ============================================
# Service URLs (Internal Docker Network)
# ============================================
ORCHESTRATOR_URL=http://orchestrator_monitor:8000
MODEL_URL=https://rpa-error-classifier-555972249634.us-central1.run.app/predict
#MODEL_URL=http://orchestrator_monitor:8000/classify --- IGNORE ---  # Local model server (for testing)
AI_LOCATOR_URL=http://ai_element_locator:8001
RABBIT_HOST=rabbitmq

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ============================================
# Bot Configuration
# ============================================
ORCHESTRATOR_ENABLED=true
PYTHONUNBUFFERED=1

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Target URLs (for SLIIT PDP RPA Bot)
# ============================================
BASE_URL=https://www.sliit.lk
TARGET_URL=https://www.sliit.lk/postgraduate-diploma-programmes/

# ============================================
# Retry Configuration
# ============================================
MAX_RETRIES=3
RETRY_DELAY=2

# ============================================
# Performance Tuning
# ============================================
HEADLESS_MODE=true
BROWSER_TIMEOUT=30000
PAGE_LOAD_TIMEOUT=60000

# ============================================
# Port Mappings (External Access)
# ============================================
# Uncomment and modify if you need different ports
# ORCHESTRATOR_PORT=8000
# MODEL_SERVER_PORT=8002
# AI_LOCATOR_PORT=8001
# HEALING_ENGINE_PORT=5001
# RABBITMQ_AMQP_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
